# ==============================================================================
# SurveyPro - Ortam Değişkenleri Şablonu (.env.example)
# Bu dosyayı .env olarak kopyalayın ve gizli değerleri güncelleyin.
# ==============================================================================

# ── 1. Sunucu Yapılandırması ──────────────────────────────────────────────────
# Ortam: development | production | test
NODE_ENV=development
# Backend API dinleme portu (Docker konteyner içi varsayılan 5001)
PORT=5001
# İstemci (Frontend) adresi — CORS ve anket linki üretimi için kullanılır
FRONTEND_URL=http://localhost:3000

# ── 2. PostgreSQL Veritabanı Yapılandırması ──────────────────────────────────
# Docker compose için host: postgres; lokal çalıştırma için host: localhost
DB_HOST=postgres
DB_PORT=5432
DB_NAME=surveypro
DB_USER=surveypro
DB_PASSWORD=surveypro_guclu_sifre_buraya

# ── 3. Redis Önbellek ve Rate Limit ──────────────────────────────────────────
# Docker compose için host: redis; lokal çalıştırma için host: localhost
REDIS_HOST=redis
REDIS_PORT=6379

# ── 4. JWT Kimlik Doğrulama (PROD ORTAMINDA MUTLAKA DEĞİŞTİRİN) ───────────────
# 64 karakterli kriptografik rastgele anahtarlar üretmek için: openssl rand -hex 64
JWT_SECRET=ornek_jwt_secret_anahtari_en_az_64_karakter_olmali_prod_degistir
JWT_REFRESH_SECRET=ornek_jwt_refresh_secret_anahtari_prod_degistir
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── 5. SMS Gateway (Nokta Bilişim) ────────────────────────────────────────────
# Varsayılan URL: http://smsportal.noktabilisim.net:3001
SMS_API_URL=http://smsportal.noktabilisim.net:3001
SMS_API_KEY=nokta_bilisim_sms_api_anahtari
SMS_HEADER=NOKTABLSM

# ── 6. WhatsApp Gateway (Nokta Bilişim) ───────────────────────────────────────
# Varsayılan URL: http://whatsapp.noktabilisim.net:3000/send-message
WHATSAPP_API_URL=http://whatsapp.noktabilisim.net:3000/send-message

# ── 7. Kurumsal E-posta / SMTP (İsteğe bağlı DB ayarları üzerinden de yönetilebilir)
SMTP_HOST=smtp.kurumunuz.com
SMTP_PORT=587
SMTP_USER=bildirim@kurumunuz.com
SMTP_PASS=kurumsal_smtp_parolasi
SMTP_SSL=false
SMTP_AUTH=true
SMTP_FROM_NAME=SurveyPro
SMTP_FROM_EMAIL=bildirim@kurumunuz.com

# ── 8. Kurumsal Marka ve Logo Yönetimi (White-Labeling) ─────────────────────────
APP_TITLE=SurveyPro
APP_LOGO=
UPLOAD_DIR=./uploads/logos
MAX_LOGO_SIZE_MB=2
